<?xml version="1.0"?>
<robot name="go2_caddie" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="use_gazebo" default="true"/>

  <xacro:property name="body_length" value="0.72"/>
  <xacro:property name="body_width" value="0.32"/>
  <xacro:property name="body_height" value="0.24"/>
  <xacro:property name="body_mass" value="15.0"/>
  <xacro:property name="wheel_radius" value="0.035"/>
  <xacro:property name="wheel_width" value="0.018"/>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x*x + z*z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (3.0 * radius * radius + length * length) / 12.0}"
        iyz="0.0"
        izz="${0.5 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <material name="go2_silver">
    <color rgba="0.72 0.76 0.78 1.0"/>
  </material>
  <material name="go2_dark">
    <color rgba="0.05 0.06 0.07 1.0"/>
  </material>
  <material name="wso2_orange">
    <color rgba="1.0 0.36 0.02 1.0"/>
  </material>
  <material name="sensor_glass">
    <color rgba="0.02 0.06 0.09 0.92"/>
  </material>
  <material name="bag_fabric">
    <color rgba="0.12 0.15 0.18 1.0"/>
  </material>
  <material name="hidden_drive">
    <color rgba="0.02 0.02 0.02 0.12"/>
  </material>

  <link name="base_footprint"/>

  <link name="base_link">
    <xacro:box_inertial mass="${body_mass}" x="${body_length}" y="${body_width}" z="${body_height}"/>
    <visual>
      <origin xyz="0 0 0.30"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="go2_silver"/>
    </visual>
    <visual>
      <origin xyz="0.02 0 0.44"/>
      <geometry>
        <box size="0.44 0.25 0.065"/>
      </geometry>
      <material name="wso2_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.30"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0"/>
  </joint>

  <link name="head_link">
    <xacro:box_inertial mass="1.0" x="0.16" y="0.24" z="0.18"/>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.16 0.24 0.18"/>
      </geometry>
      <material name="go2_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.16 0.24 0.18"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_head" type="fixed">
    <parent link="base_link"/>
    <child link="head_link"/>
    <origin xyz="0.43 0 0.32"/>
  </joint>

  <link name="bag_rack_link">
    <xacro:box_inertial mass="2.0" x="0.45" y="0.22" z="0.12"/>
    <visual>
      <origin xyz="-0.08 0 0.02" rpy="0 0.25 0"/>
      <geometry>
        <box size="0.50 0.22 0.12"/>
      </geometry>
      <material name="bag_fabric"/>
    </visual>
    <visual>
      <origin xyz="-0.18 0.14 0.13" rpy="0.35 0.0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.55"/>
      </geometry>
      <material name="go2_dark"/>
    </visual>
    <visual>
      <origin xyz="-0.18 -0.14 0.13" rpy="0.35 0.0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.55"/>
      </geometry>
      <material name="go2_dark"/>
    </visual>
  </link>

  <joint name="base_to_bag_rack" type="fixed">
    <parent link="base_link"/>
    <child link="bag_rack_link"/>
    <origin xyz="-0.08 0 0.49"/>
  </joint>

  <xacro:macro name="go2_leg" params="name x y hip_sign">
    <link name="${name}_hip_link">
      <xacro:box_inertial mass="0.5" x="0.09" y="0.07" z="0.07"/>
      <visual>
        <geometry>
          <box size="0.09 0.07 0.07"/>
        </geometry>
        <material name="go2_dark"/>
      </visual>
    </link>
    <joint name="${name}_hip_fixed" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_hip_link"/>
      <origin xyz="${x} ${y} 0.24"/>
    </joint>

    <link name="${name}_upper_leg_link">
      <xacro:cylinder_inertial mass="0.55" radius="0.025" length="0.26"/>
      <visual>
        <origin xyz="0 0 -0.13" rpy="0.35 0 0"/>
        <geometry>
          <cylinder radius="0.025" length="0.26"/>
        </geometry>
        <material name="go2_silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 -0.13" rpy="0.35 0 0"/>
        <geometry>
          <cylinder radius="0.025" length="0.26"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_upper_leg_fixed" type="fixed">
      <parent link="${name}_hip_link"/>
      <child link="${name}_upper_leg_link"/>
      <origin xyz="0 ${0.055 * hip_sign} -0.045" rpy="0.18 0 0"/>
    </joint>

    <link name="${name}_lower_leg_link">
      <xacro:cylinder_inertial mass="0.45" radius="0.022" length="0.31"/>
      <visual>
        <origin xyz="0 0 -0.15" rpy="-0.28 0 0"/>
        <geometry>
          <cylinder radius="0.022" length="0.31"/>
        </geometry>
        <material name="go2_silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 -0.15" rpy="-0.28 0 0"/>
        <geometry>
          <cylinder radius="0.022" length="0.31"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_lower_leg_fixed" type="fixed">
      <parent link="${name}_upper_leg_link"/>
      <child link="${name}_lower_leg_link"/>
      <origin xyz="0 ${0.055 * hip_sign} -0.26" rpy="-0.15 0 0"/>
    </joint>

    <link name="${name}_foot_link">
      <xacro:box_inertial mass="0.18" x="0.10" y="0.055" z="0.035"/>
      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <box size="0.10 0.055 0.035"/>
        </geometry>
        <material name="go2_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0"/>
        <geometry>
          <box size="0.10 0.055 0.035"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_foot_fixed" type="fixed">
      <parent link="${name}_lower_leg_link"/>
      <child link="${name}_foot_link"/>
      <origin xyz="0 ${0.035 * hip_sign} -0.29"/>
    </joint>
  </xacro:macro>

  <xacro:go2_leg name="front_left" x="0.25" y="0.18" hip_sign="1"/>
  <xacro:go2_leg name="front_right" x="0.25" y="-0.18" hip_sign="-1"/>
  <xacro:go2_leg name="rear_left" x="-0.25" y="0.18" hip_sign="1"/>
  <xacro:go2_leg name="rear_right" x="-0.25" y="-0.18" hip_sign="-1"/>

  <xacro:macro name="drive_wheel" params="name x y side">
    <link name="${name}_wheel_link">
      <xacro:cylinder_inertial mass="0.04" radius="${wheel_radius}" length="${wheel_width}"/>
      <visual>
        <origin rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="hidden_drive"/>
      </visual>
      <collision>
        <origin rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel name="left_front" x="0.24" y="0.23" side="1"/>
  <xacro:drive_wheel name="left_rear" x="-0.24" y="0.23" side="1"/>
  <xacro:drive_wheel name="right_front" x="0.24" y="-0.23" side="-1"/>
  <xacro:drive_wheel name="right_rear" x="-0.24" y="-0.23" side="-1"/>

  <link name="lidar_link">
    <xacro:cylinder_inertial mass="0.2" radius="0.045" length="0.045"/>
    <visual>
      <origin rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.045"/>
      </geometry>
      <material name="sensor_glass"/>
    </visual>
  </link>
  <joint name="base_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.29 0 0.49"/>
  </joint>

  <link name="camera_link">
    <xacro:box_inertial mass="0.25" x="0.08" y="0.14" z="0.06"/>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.08 0.14 0.06"/>
      </geometry>
      <material name="sensor_glass"/>
    </visual>
  </link>
  <joint name="head_to_camera" type="fixed">
    <parent link="head_link"/>
    <child link="camera_link"/>
    <origin xyz="0.085 0 0.02"/>
  </joint>

  <link name="camera_rgb_optical_frame"/>
  <joint name="camera_to_rgb_optical" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_rgb_optical_frame"/>
    <origin xyz="0.045 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
  </joint>

  <link name="camera_depth_optical_frame"/>
  <joint name="camera_to_depth_optical" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0.045 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
  </joint>

  <link name="imu_link">
    <xacro:box_inertial mass="0.05" x="0.04" y="0.04" z="0.02"/>
    <visual>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
      <material name="go2_dark"/>
    </visual>
  </link>
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.43"/>
  </joint>

  <gazebo reference="base_link">
    <material>Gazebo/Silver</material>
  </gazebo>
  <gazebo reference="bag_rack_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <xacro:if value="$(arg use_gazebo)">
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_front_wheel_joint</left_joint>
        <left_joint>left_rear_wheel_joint</left_joint>
        <right_joint>right_front_wheel_joint</right_joint>
        <right_joint>right_rear_wheel_joint</right_joint>
        <wheel_separation>0.46</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <odom_publish_frequency>50</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <max_linear_acceleration>0.8</max_linear_acceleration>
        <min_linear_acceleration>-0.8</min_linear_acceleration>
        <max_angular_acceleration>1.6</max_angular_acceleration>
        <min_angular_acceleration>-1.6</min_angular_acceleration>
      </plugin>
    </gazebo>

    <gazebo reference="lidar_link">
      <sensor name="go2_front_lidar" type="gpu_lidar">
        <topic>/scan</topic>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>18.0</max>
            <resolution>0.02</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

    <gazebo reference="camera_link">
      <sensor name="go2_rgbd_camera" type="rgbd_camera">
        <topic>/camera</topic>
        <update_rate>20</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>12.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>

    <gazebo reference="imu_link">
      <sensor name="go2_imu" type="imu">
        <topic>/imu</topic>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
