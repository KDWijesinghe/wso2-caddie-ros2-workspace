  <joint name="front_camera_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.32715 -0.00003 0.04297" />
      <parent link="base" />
      <child link="front_camera" />
  </joint>
  <link name="front_camera">
  </link>

  <xacro:if value="$(arg use_leg_control)">
    <ros2_control name="go2_caddie_leg_control" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <xacro:leg_position_joint joint_name="FL_hip_joint" lower="-0.85" upper="0.85" initial="0.0"/>
      <xacro:leg_position_joint joint_name="FL_thigh_joint" lower="-0.8" upper="2.0" initial="0.78"/>
      <xacro:leg_position_joint joint_name="FL_calf_joint" lower="-2.55" upper="-0.9" initial="-1.55"/>

      <xacro:leg_position_joint joint_name="FR_hip_joint" lower="-0.85" upper="0.85" initial="0.0"/>
      <xacro:leg_position_joint joint_name="FR_thigh_joint" lower="-0.8" upper="2.0" initial="0.78"/>
      <xacro:leg_position_joint joint_name="FR_calf_joint" lower="-2.55" upper="-0.9" initial="-1.55"/>

      <xacro:leg_position_joint joint_name="RL_hip_joint" lower="-0.85" upper="0.85" initial="0.0"/>
      <xacro:leg_position_joint joint_name="RL_thigh_joint" lower="-0.8" upper="2.0" initial="0.78"/>
      <xacro:leg_position_joint joint_name="RL_calf_joint" lower="-2.55" upper="-0.9" initial="-1.55"/>

      <xacro:leg_position_joint joint_name="RR_hip_joint" lower="-0.85" upper="0.85" initial="0.0"/>
      <xacro:leg_position_joint joint_name="RR_thigh_joint" lower="-0.8" upper="2.0" initial="0.78"/>
      <xacro:leg_position_joint joint_name="RR_calf_joint" lower="-2.55" upper="-0.9" initial="-1.55"/>
    </ros2_control>
  </xacro:if>

  <link name="bag_rack_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.012" ixy="0" ixz="0" iyy="0.045" iyz="0" izz="0.040"/>
    </inertial>
    <visual>
      <origin xyz="-0.08 0 0.02" rpy="0 0.25 0"/>
      <geometry>
        <box size="0.50 0.22 0.12"/>
      </geometry>
      <material name="caddie_bag_black">
        <color rgba="0.12 0.15 0.18 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.08 0 0.02" rpy="0 0.25 0"/>
      <geometry>
        <box size="0.50 0.22 0.12"/>
      </geometry>
    </collision>
  </link>
  <joint name="base_to_bag_rack" type="fixed">
    <origin xyz="-0.06 0 0.18" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="bag_rack_link"/>
  </joint>

  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.045"/>
      </geometry>
      <material name="caddie_sensor_glass">
        <color rgba="0.02 0.06 0.09 0.92"/>
      </material>
    </visual>
  </link>
  <joint name="base_to_lidar" type="fixed">
    <origin xyz="0.30 0 0.08" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="lidar_link"/>
  </joint>

  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.08 0.14 0.06"/>
      </geometry>
      <material name="caddie_camera_black">
        <color rgba="0.02 0.06 0.09 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="base_to_camera_link" type="fixed">
    <origin xyz="0.345 0 0.03" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="camera_link"/>
  </joint>

  <link name="camera_rgb_optical_frame"/>
  <joint name="camera_to_rgb_optical" type="fixed">
    <origin xyz="0.045 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    <parent link="camera_link"/>
    <child link="camera_rgb_optical_frame"/>
  </joint>

  <link name="camera_depth_optical_frame"/>
  <joint name="camera_to_depth_optical" type="fixed">
    <origin xyz="0.045 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="base_to_imu_link" type="fixed">
    <origin xyz="-0.02557 0 0.04232" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="imu_link"/>
  </joint>

  <link name="left_front_wheel_link">
    <inertial><mass value="0.04"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.045" length="0.025"/></geometry></collision>
  </link>
  <joint name="left_front_wheel_joint" type="continuous">
    <origin xyz="0.22 0.16 -0.49" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="left_front_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="left_rear_wheel_link">
    <inertial><mass value="0.04"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.045" length="0.025"/></geometry></collision>
  </link>
  <joint name="left_rear_wheel_joint" type="continuous">
    <origin xyz="-0.22 0.16 -0.49" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="left_rear_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_front_wheel_link">
    <inertial><mass value="0.04"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.045" length="0.025"/></geometry></collision>
  </link>
  <joint name="right_front_wheel_joint" type="continuous">
    <origin xyz="0.22 -0.16 -0.49" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="right_front_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_rear_wheel_link">
    <inertial><mass value="0.04"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.045" length="0.025"/></geometry></collision>
  </link>
  <joint name="right_rear_wheel_joint" type="continuous">
    <origin xyz="-0.22 -0.16 -0.49" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="right_rear_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:if value="$(arg use_gazebo)">
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_front_wheel_joint</left_joint>
        <left_joint>left_rear_wheel_joint</left_joint>
        <right_joint>right_front_wheel_joint</right_joint>
        <right_joint>right_rear_wheel_joint</right_joint>
        <wheel_separation>0.32</wheel_separation>
        <wheel_radius>0.045</wheel_radius>
        <odom_publish_frequency>50</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <max_linear_acceleration>0.8</max_linear_acceleration>
        <min_linear_acceleration>-0.8</min_linear_acceleration>
        <max_angular_acceleration>1.6</max_angular_acceleration>
        <min_angular_acceleration>-1.6</min_angular_acceleration>
      </plugin>
    </gazebo>

    <xacro:if value="$(arg use_leg_control)">
      <gazebo>
        <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find caddie_description)/config/go2_leg_controllers.yaml</parameters>
          <hold_joints>true</hold_joints>
          <position_proportional_gain>60.0</position_proportional_gain>
        </plugin>
      </gazebo>
    </xacro:if>

    <gazebo reference="lidar_link">
      <sensor name="go2_front_lidar" type="gpu_lidar">
        <topic>/scan</topic>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>18.0</max>
            <resolution>0.02</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>

    <gazebo reference="camera_link">
      <sensor name="go2_rgbd_camera" type="rgbd_camera">
        <topic>/camera</topic>
        <update_rate>20</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>12.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>

    <gazebo reference="imu_link">
      <sensor name="go2_imu" type="imu">
        <topic>/imu</topic>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
