<mujoco model="golf_course_env">
    <compiler assetdir="assets" autolimits="true"/>
    
    <option timestep="0.002" gravity="0 0 -9.81"/>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        
        <texture type="2d" name="grass_texture" builtin="checker" mark="edge" rgb1="0.13 0.55 0.13" rgb2="0.1 0.45 0.1" width="300" height="300" markrgb="0.2 0.6 0.2"/>
        <material name="grass_mat" texture="grass_texture" texrepeat="10 10" texuniform="true"/>

        <texture type="2d" name="sand_texture" builtin="flat" rgb1="0.85 0.75 0.55" width="100" height="100"/>
        <material name="sand_mat" texture="sand_texture"/>
    </asset>

    <worldbody>
        <light mode="fixed" directional="true" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" pos="0 0 10" dir="0 0 -1"/>

        <geom name="fairway" type="plane" size="20 20 0.1" material="grass_mat" friction="0.6 0.005 0.0001"/>

        <geom name="sand_bunker" type="box" size="3 4 0.01" pos="4 4 0.005" material="sand_mat" friction="1.2 0.01 0.001"/>

        <body name="golf_hole" pos="6 6 0">
            <geom type="cylinder" size="0.15 0.001" rgba="0 0 0 1" pos="0 0 0.001"/>
            <geom type="cylinder" size="0.02 1.2" pos="0 0 0.6" rgba="0.8 0.8 0.8 1"/>
            <geom type="box" size="0.2 0.01 0.15" pos="0.2 0 1.1" rgba="0.9 0.1 0.1 1"/>
        </body>

        <body name="golf_ball" pos="2 2 0.1">
            <freejoint name="ball_joint"/> <geom name="ball_geom" type="sphere" size="0.045" mass="0.045" rgba="1 1 1 1" friction="0.4 0.005 0.0001"/>
        </body>

        <include file="go2.xml"/>
    </worldbody>
</mujoco>