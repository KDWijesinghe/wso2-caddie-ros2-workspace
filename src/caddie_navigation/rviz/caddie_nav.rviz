Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: map
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: Go2 Caddie
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
    - Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: SLAM Map
      Topic:
        Value: /map
    - Class: rviz_default_plugins/LaserScan
      Color: 255; 120; 20
      Enabled: true
      Name: Lidar
      Size (m): 0.03
      Style: Points
      Topic:
        Value: /scan
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Ball Markers
      Topic:
        Value: /caddie/ball_markers
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Caddie Target
      Topic:
        Value: /caddie/target_marker
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Global Plan
      Topic:
        Value: /plan
  Enabled: true
  Global Options:
    Background Color: 38; 42; 45
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Orbit
      Pitch: 0.85
      Target Frame: map
      Yaw: 0.78
Window Geometry:
  Height: 900
  Width: 1400
